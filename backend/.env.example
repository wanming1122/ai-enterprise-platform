# 数据库连接（MySQL 8，utf8mb4）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=enterprise

# JWT 密钥与有效期（生产环境务必更换随机强密钥）
JWT_SECRET=随机长字符串
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# 存储目录（相对 backend 运行目录）
MEDIA_DIR=./media
CHROMA_DIR=./data/chroma

# 模型 API
# AI 功能（知识库问答 / AI助手 / NL2SQL 生成）推荐在「AI智能中心 → 模型配置」
# 页面录入 base_url 与 api_key（Fernet 加密入库，DB 默认配置优先）；
# 以下项仅作为未配置默认模型时的兜底，可先留空。
ZHIPU_API_KEY=            # 默认Embedding（智谱embedding-3）
MIMO_BASE_URL=            # MiMo-V2.5接入地址（OpenAI兼容）
MIMO_API_KEY=
MIMO_MODEL=MiMo-V2.5      # 生成模型
MIMO_EMBEDDING_MODEL=text-embedding-v3

# 模型密钥 Fernet 加密密钥（必填，ai_model.api_key 加密存储）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# SMTP 邮件（找回密码验证码真实下发；留空则回退演示回显模式）
# 端口 465 走 SSL，587 走 STARTTLS；发件邮箱需在服务商处开启 SMTP 并获取授权码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
